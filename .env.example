# dsh-lark-bot runtime configuration.
#
# This file is a template only. Never commit real credentials.
# At runtime the bot reads DSH_LARK_* variables and merges them with
# ~/.dsh-lark/config.json.

# Feishu / Lark application credentials. Prefer first-run QR binding; these
# variables are optional overrides for automated deployment.
# DSH_LARK_APP_ID=
# DSH_LARK_APP_SECRET=

# Feishu (default) or Lark international tenant.
DSH_LARK_TENANT=feishu

# Root directory for local state. Defaults to ~/.dsh-lark.
# DSH_LARK_HOME=

# Managed multi-bot services set these automatically. Do not reuse one bridge
# profile for two dsh processes.
# DSH_LARK_PROFILE=reviewer
# DSH_LARK_DSH_PROFILE=dsh-lark-reviewer

# Default working directory for new sessions.
# DSH_LARK_WORKSPACE=

# Optional DeepSeek Harness overrides. The CLI auto-discovers installed dsh
# installations such as ~/.dsh/profiles/node_modules/@deepseek-ai/dsh.
# Set these only when you need an explicit launcher or custom profile.
# DSH_LARK_DSH_COMMAND=
# DSH_LARK_DSH_ARGS=

# Agent backend mode: web (default, drives the local dsh Web session), sdk
# (official client + per-action approval), acp (protocol-native approval via
# session/request_permission), or headless (legacy fallback).
DSH_LARK_ADAPTER=web

# npm latest-version probes used by doctor, /version, /upgrade, and the
# best-effort reminder after /new or /reset. Disabled by default in this fork:
# its compatibility package name is still the upstream npm name, so enabling
# this before publishing an independent package can replace the fork with the
# upstream release.
DSH_LARK_UPGRADE_CHECK=0

# Bridge new-version check interval in ms (0 disables; default 6h).
# DSH_LARK_UPGRADE_CHECK_INTERVAL_MS=21600000

# Push a Feishu notification when a newer version is found (default: log-only).
# DSH_LARK_UPGRADE_NOTIFY=false
# DSH_LARK_UPGRADE_NOTIFY_CHAT=

# Provider/model route for the dsh agent.
# Optional when dsh agent-default-model already contains { provider, model }.
# SDK/ACP startup fails with an explicit bridge configuration error if neither
# source resolves a complete route. Managed restarts retain saved values that
# the current shell does not explicitly override.
# DSH_LARK_PROVIDER=provider-id
# DSH_LARK_MODEL=model-id

# Optional per-request output token cap for SDK-created agents.
# DSH_LARK_MAX_TOKENS=49152

# Long-edge bound (px) for inbound images before upload. Inbound screenshots
# whose longer side exceeds this are downscaled proportionally so they fit the
# upstream attachment-store admission limit (default 2000, matching
# dsh-attachment-local's maxImageDimension). Set 0 to disable scaling.
# DSH_LARK_IMAGE_MAX_DIMENSION=2000

# web adapter: base URL of the local dsh web agent. A Web-created session is
# detached from Feishu by default. A Feishu chat creates its own session on the
# first ordinary message, while /use switches explicitly without history replay.
# DSH_LARK_WEB_URL=http://127.0.0.1:3080
# Optional models.dev-compatible provider/model catalog mirror.
# DSH_LARK_MODEL_CATALOG_URL=https://models.dev/api.json
# DSH_LARK_SESSION_PROJECTION=1
# DSH_LARK_SESSION_BACKFILL_MESSAGES=20
# DSH_LARK_SESSION_BACKFILL_BYTES=65536
# DSH_LARK_SESSION_STREAM_UPDATE_MS=800

# Deprecated compatibility alias. It is read only when
# DSH_LARK_SESSION_PROJECTION is absent; it no longer enables auto-switching.
# DSH_LARK_WEB_PUSH=1

# Security: reject DM traffic when no allowlist is configured (1) or keep the
# onboarding-friendly open default (0).
DSH_LARK_ACCESS_DEFAULT_DENY=0

# Reject message events older than this window (ms). 0 disables the check.
DSH_LARK_EVENT_FRESHNESS_MS=600000

# Optional no-@ group delivery. When enabled, the bridge polls message history
# only for previously observed group/topic chats and only accepts explicitly
# allowlisted human senders. Requires Feishu scope im:message.group_msg.
DSH_LARK_GROUP_NO_AT=false
DSH_LARK_GROUP_POLL_MS=3000

# Maximum consecutive trusted bot-to-bot @ handoffs across the local fleet.
# Any fresh human message resets the shared counter.
DSH_LARK_BOT_HANDOFF_MAX=6

# Optional idle timeout for a single agent run, in milliseconds. A run is
# stopped only after it has been silent (no streaming events / tool activity)
# for this long; actively working runs are never cut short.
DSH_LARK_RUN_TIMEOUT_MS=300000

# Grace period allowed after SIGTERM before SIGKILL, in milliseconds.
DSH_LARK_STOP_GRACE_MS=5000

# Max agent runs allowed concurrently within one scope (chat/topic).
# Default 2 lets PM / dev / docs roles work in parallel; set 1 for strictly
# serial per-scope execution, or use /concurrency in chat to override.
DSH_LARK_SCOPE_CONCURRENCY=2
# Bootstrap fallback only: Plain Markdown cannot vary per viewer. Choose zh,
# en, or bilingual (default); `/language` persists the profile policy and is
# authoritative after startup. Card UI always remains per-viewer.
# DSH_LARK_REPLY_LANG=bilingual
# DSH_LARK_SECRET_URL is an internal localhost callback generated per boot;
# never configure it manually or expose it outside the host.
# off | completed (completed + failed) | all (completed + failed + approval)
DSH_LARK_NOTIFICATION_DEFAULT=off

# Outbound notification channels (issue #113): push-only forwarding of
# completed/failed/approval/urgent notifications to other IMs (Telegram,
# WeCom group robot, …). No environment variable is required — configure
# them in chat as an admin with `/channels`, and opt a scope in with
# `/notifications on … sinks=<id1,id2>`. Credentials are stored at mode 0600
# in <profile>/notification-channels.json and are never echoed.

# Installed as a dsh profile bundle: the plugin starts the bridge engine
# in-process when the profile boots. Set this to 1 to keep the engine stopped
# while the plugin stays loaded as a standard dsh plugin.
# DSH_LARK_DISABLED=0

# Session / task archival: live messages kept per scope + workspace before overflow is
# archived (0 keeps everything), max archives retained per scope + workspace, and the
# max age of an archive in days (0 disables pruning).
DSH_LARK_RETENTION_MSGS=40
DSH_LARK_ARCHIVE_MAX=50
DSH_LARK_ARCHIVE_MAX_AGE_DAYS=90

# Feishu channel liveness watchdog. The engine detects a half-open WebSocket
# (TCP still ESTABLISHED but Feishu not delivering) and force-reconnects it.
# It never starts or restarts DSH; when DSH stops, Feishu stops with it.
DSH_LARK_CHANNEL_PING_TIMEOUT_SEC=30
# DSH_LARK_CHANNEL_KEEPALIVE=1
DSH_LARK_CHANNEL_KEEPALIVE_MS=15000
DSH_LARK_CHANNEL_HEALTH_POLL_MS=5000

# One-command upgrade (issue #10): npm registry used by `dsh-lark-bot upgrade`
# to discover the latest published version. Defaults to the official npm
# registry; set to a mirror when the default is unreachable from your network.
# DSH_LARK_UPGRADE_REGISTRY=https://registry.npmjs.org

# Show the agent's reasoning phase in Feishu (default off).
# Off keeps the phone on request -> answer; the run card reports 正在处理
# instead of 正在思考, and reasoning text is never projected.
# DSH_LARK_SHOW_THINKING=1

# Show the live progress card instead of a reaction (default off).
# Off is the phone-friendly shape: react to acknowledge, work silently, then
# send one result. Approval/question/plan cards are unaffected either way.
# DSH_LARK_PROGRESS_CARD=1
