{
  "name": "dsh-lark-bot",
  "version": "0.19.18-local.rc2.4",
  "description": "DSH飞书Session控制：把 DeepSeek Harness (dsh) 接入飞书/Lark，统一远程 session 控制、稳定别名、回收站、永久清理、Web 管理和半/完整衔接。| DSH Feishu Session Control: a unified Feishu/Lark bridge for remote session control, stable aliases, recycle-bin lifecycle, Web management, and half/full connection modes.",
  "author": "见川",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "dsh-lark-bot": "bin/dsh-lark-bot.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./client": "./dist/client.js",
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "import": "./dist/invariant.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "import": "./dist/ask.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./dist/approval.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js"
    },
    "./secret": {
      "types": "./dist/secret.d.ts",
      "import": "./dist/secret.js"
    },
    "./sdk-server": {
      "types": "./dist/sdk-server.d.ts",
      "import": "./dist/sdk-server.js"
    },
    "./skill": {
      "types": "./dist/skill.d.ts",
      "import": "./dist/skill.js"
    },
    "./session-manager": {
      "types": "./dist/session-manager.d.ts",
      "import": "./dist/session-manager.js"
    },
    "./plugin-manager": {
      "types": "./dist/plugin-manager.d.ts",
      "import": "./dist/plugin-manager.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README_EN.md",
    "SECURITY.md",
    "NOTICE.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "file:read",
      "file:write",
      "network:outbound",
      "network:listen",
      "process:spawn",
      "credentials:read",
      "credentials:write",
      "harness:tool",
      "harness:event"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.2",
        "0.1.5-rc.3",
        "0.1.2-rc.1",
        "0.2.1-rc.2",
        "0.2.1-rc.3"
      ]
    },
    "capability": {
      "id": "lark_notify",
      "kind": "tool",
      "invocation": "invoke the model-facing lark_notify tool through the host agent runtime with a target Feishu/Lark scope (chat or topic), message text, and optional member mentions",
      "expected": "the bridge notify callback (bound to 127.0.0.1 with a per-boot random token) accepts the call and the message card is delivered to the target scope with the requested mentions; an invalid or unreachable target returns a structured failure result without terminating the run"
    },
    "evidence": {
      "install": "docs/QUICK_START.md",
      "failureIsolation": "test/plugin.test.ts",
      "hotReload": null,
      "remove": "docs/QUICK_START.md"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "start": "node bin/dsh-lark-bot.mjs start",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "postbuild": "node scripts/sync-plugin-digest.mjs",
    "check:publish-bundle": "node scripts/check-publish-bundle.mjs",
    "check:tui-admission": "node scripts/check-tui-admission.mjs",
    "check:tui-tty": "node scripts/check-tui-tty.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:local": "git diff --check && pnpm typecheck && pnpm test && pnpm build && pnpm check:tui-admission && pnpm check:tui-tty && pnpm check:publish-bundle && node bin/dsh-lark-bot.mjs --version",
    "release:check": "pnpm ci:local && node scripts/check-dsh-upstream.mjs && pnpm compat:probe",
    "dsh:upstream": "node scripts/check-dsh-upstream.mjs",
    "upstream:report": "node scripts/check-dsh-upstream.mjs",
    "compat:probe": "node scripts/probe-dsh-compat.mjs",
    "security:monitor": "node scripts/monitor-impostor-repo.mjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "publish:dual": "node scripts/publish-dual-packages.mjs",
    "publish:dual:dry-run": "node scripts/publish-dual-packages.mjs --dry-run",
    "publish:github:dry-run": "node scripts/publish-dual-packages.mjs --github --dry-run",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek harness",
    "deepseek-harness 插件",
    "deepseek harness 飞书",
    "feishu",
    "飞书",
    "飞书机器人",
    "lark",
    "bridge",
    "bot",
    "扫码",
    "scan to connect",
    "typescript",
    "chatbot",
    "deepseek-harness",
    "dsh-plugin",
    "feishu-plugin",
    "lark-integration",
    "remote-coding",
    "dsh-web-settings"
  ],
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@larksuite/channel": "^0.4.1",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1 || 0.1.5-rc.3 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-namehard/dsh-feishu-session-control.git"
  },
  "bugs": {
    "url": "https://github.com/jason-namehard/dsh-feishu-session-control/issues"
  },
  "homepage": "https://github.com/jason-namehard/dsh-feishu-session-control#readme"
}
